#!/usr/bin/env bash
# shellcheck source-path=..
set -eo pipefail; shopt -s inherit_errexit
PKGROOT=$(realpath "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/..")
source "$PKGROOT/.upkg/records.sh/records.sh"
CONFIGDIR=$HOME/.config/k8sss

main() {
  DOC="k8sss - Issue Kubernetes client certificates via Smallstep
Usage:
  k8sss setup [--ca-url URL -k KN -u UN --context NAME --cluster NAME] KUBEAPI_URL
  k8sss rm [--context NAME] KUBEAPI_HOSTNAME
  k8sss ls
  k8sss cert [--ca-url URL -k KN -u UN] KUBEAPI_HOSTNAME

Options:
  -c --ca-url URL   URL to the CA [default: https://\$KUBEAPI_HOSTNAME:9000]
  -k --keyuri URI   Smallstep key URI used for authentication
                    [default: sshagentkms:\$USER@\$HOST]
  -u --username UN  K8S username to authenticate as [default: system:admin]
  --context NAME    Name of the context add/remove [default: \$KUBEAPI_HOSTNAME]
  --cluster NAME    Name of the cluster add [default: \$KUBEAPI_HOSTNAME]
"
# docopt parser below, refresh this parser with `docopt.sh k8sss`
# shellcheck disable=2016,2086,2329,1090,1091,2034
docopt() { local v='2.0.3'; source \
"$PKGROOT/.upkg/docopt-lib.sh-v$v/docopt-lib.sh" "$v" || { ret=$?;printf -- \
"exit %d\n" "$ret";exit "$ret";};set -e;trimmed_doc=${DOC:0:693}
usage=${DOC:59:202};digest=0b403;options=('-c --ca-url 1' '-k --keyuri 1' '-u '\
'--username 1' ' --context 1' ' --cluster 1');node_0(){ value __ca_url 0;}
node_1(){ value __keyuri 1;};node_2(){ value __username 2;};node_3(){ value \
__context 3;};node_4(){ value __cluster 4;};node_5(){ value KUBEAPI_URL a;}
node_6(){ value KUBEAPI_HOSTNAME a;};node_7(){ switch setup a:setup;};node_8(){
switch rm a:rm;};node_9(){ switch ls a:ls;};node_10(){ switch cert a:cert;}
node_11(){ sequence 7 12 5;};node_12(){ optional 0 1 2 3 4;};node_13(){
sequence 8 14 6;};node_14(){ optional 3;};node_15(){ sequence 10 16 6;}
node_16(){ optional 0 1 2;};node_17(){ choice 11 13 9 15;};cat <<<' \
docopt_exit() { [[ -n $1 ]] && printf "%s\n" "$1" >&2;printf "%s\n" \
"${DOC:59:202}" >&2;exit 1;}';local varnames=(__ca_url __keyuri __username \
__context __cluster KUBEAPI_URL KUBEAPI_HOSTNAME setup rm ls cert) varname;for \
varname in "${varnames[@]}"; do unset "var_$varname";done;parse 17 "$@";local \
p=${DOCOPT_PREFIX:-''};for varname in "${varnames[@]}"; do unset "$p$varname"
done;eval $p'__ca_url=${var___ca_url:-'"'"'https://$KUBEAPI_HOSTNAME:9000'"'\
"'};'$p'__keyuri=${var___keyuri:-'"'"'sshagentkms:$USER@$HOST'"'"'};'$p'__user'\
'name=${var___username:-system:admin};'$p'__context=${var___context:-'\
"'"'$KUBEAPI_HOSTNAME'"'"'};'$p'__cluster=${var___cluster:-'\
"'"'$KUBEAPI_HOSTNAME'"'"'};'$p'KUBEAPI_URL=${var_KUBEAPI_URL:-};'$p'KUBEAPI_H'\
'OSTNAME=${var_KUBEAPI_HOSTNAME:-};'$p'setup=${var_setup:-false};'$p'rm=${var_'\
'rm:-false};'$p'ls=${var_ls:-false};'$p'cert=${var_cert:-false};';local \
docopt_i=1;[[ $BASH_VERSION =~ ^4.3 ]] && docopt_i=2;for \
((;docopt_i>0;docopt_i--)); do for varname in "${varnames[@]}"; do declare -p \
"$p$varname";done;done;}
# docopt parser above, complete command for generating this parser is `docopt.sh --library='"$PKGROOT/.upkg/docopt-lib.sh-v$v/docopt-lib.sh"' k8sss`
  eval "$(docopt "$@")"

  export KUBECONFIG="$HOME/.kube/config.yaml"

  # shellcheck disable=SC2154
  if $setup; then
    [[ $KUBEAPI_URL =~ ^(https?://)?([^:]+)(:[^:]+)? ]] || fatal "Unable to parse KUBEAPI_URL '%s'" "$KUBEAPI_URL"
    KUBEAPI_HOSTNAME=${BASH_REMATCH[2]}
    KUBEAPI_URL=${BASH_REMATCH[1]:-"https://"}${BASH_REMATCH[2]}${BASH_REMATCH[3]}
  fi
  [[ $__keyuri != "sshagentkms:\$USER@\$HOST" ]] || __keyuri=sshagentkms:$(id -un)@$(hostname)
  [[ $__context != \$KUBEAPI_HOSTNAME ]] || __context=$KUBEAPI_HOSTNAME
  [[ $__cluster != \$KUBEAPI_HOSTNAME ]] || __cluster=$KUBEAPI_HOSTNAME
  [[ $__ca_url != https://\$KUBEAPI_HOSTNAME:9000 ]] || __ca_url=https://$KUBEAPI_HOSTNAME:9000
  local config_dir=$CONFIGDIR/${KUBEAPI_HOSTNAME}
  # shellcheck disable=SC2154
  local \
    kubeapi_server_ca_crt=$config_dir/server-ca.crt \
    kubeapi_client_ca_crt=$config_dir/client-ca.crt \
    user_crt=$config_dir/${__username}.crt \
    user_key=$config_dir/${__username}.key

  # shellcheck disable=SC2154
  if $ls; then
    local name
    for name in "$CONFIGDIR"/*; do
      [[ ! -d $name ]] || printf "%s\n" "$(basename "$name")"
    done
  elif $rm; then
    local context_data cluster user
    rm -rf "$CONFIGDIR/${KUBEAPI_HOSTNAME:?}"
    if context_data=$(kubectl config view -ojson | jq -re --arg name "$__context" '.contexts[] | select(.name == $name)' 2>/dev/null); then
      ! cluster=$(jq -re '.context.cluster' <<<"$context_data") || kubectl config delete-cluster "$cluster"
      ! user=$(jq -re '.context.user' <<<"$context_data") || kubectl config delete-user "$user"
      kubectl config delete-context "$__context"
    else
      warning "Unable to find context the '%s' in your kubeconfig. You will have to remove the user, cluster, and context manually" "$__context"
    fi
  elif $setup; then
    local yesno remote_kube_api_server_ca remote_kube_api_server_ca_fp kube_api_server_ca_fp remote_kube_api_client_ca
    trap 'error "Failed to configure, run with LOGLEVEL=verbose to see more detailed errors"' ERR
    remote_kube_api_server_ca=$(step certificate inspect --insecure --bundle --format pem "$KUBEAPI_URL") || \
      fatal "Unable to retrieve kube-api server certificate from %s" "$KUBEAPI_URL"
    # We got a bundle now, remove all but the last crt to get the CA
    remote_kube_api_server_ca=$'-----BEGIN CERTIFICATE-----\n'${remote_kube_api_server_ca##*-----BEGIN CERTIFICATE-----}
    # TOFU for Kubernetes API Server CA
    remote_kube_api_server_ca_fp=$(step certificate fingerprint /dev/stdin <<<"$remote_kube_api_server_ca")
    if [[ -e "$kubeapi_server_ca_crt" ]]; then
      info "Checking existing Kubernetes API server CA certificate"
      local kube_api_server_ca_fp
      kube_api_server_ca_fp=$(step certificate fingerprint "$kubeapi_server_ca_crt")
      if [[ $remote_kube_api_server_ca_fp != "$kube_api_server_ca_fp" ]]; then
        printf "Saved fingerprint:  %s\n" "$remote_kube_api_server_ca_fp" >&2
        printf "Remote fingerprint: %s\n" "$kube_api_server_ca_fp" >&2
        error "The saved Kubernetes API server CA certificate fingerprint does not match the one from the server!"
        [[ $(read -rp 'Are you sure you want to continue? [y/N]' yesno; echo "$yesno") =~ ^[Yy](es)?$ ]] || \
          { trap '' ERR; fatal "User aborted operation"; }
      fi
    else
      warning "No trust has been established with this Kubernetes cluster yet.\nThe root certificate fingerprint is %s" "$remote_kube_api_server_ca_fp"
      [[ $(read -rp 'Do you want to establish that trust now? [y/N]' yesno; echo "$yesno") =~ ^[Yy](es)?$ ]] || \
        { trap '' ERR; fatal "User aborted operation"; }
    fi
    mkdir -p "$config_dir"
    printf "%s\n" "$remote_kube_api_server_ca" >"$kubeapi_server_ca_crt"

    info "Downloading Kubernetes API Client CA certificate"
    remote_kube_api_client_ca=$(curl -k --no-progress-meter "$__ca_url/roots.pem" 2> >(LOGPROGRAM=curl pipe_verbose))
    printf "%s\n" "$remote_kube_api_client_ca" >"$kubeapi_client_ca_crt"

    info "Setting up %s" "${KUBECONFIG//"$HOME"/"~"}"
    kubectl config --kubeconfig "$KUBECONFIG" set-cluster "$__cluster" \
      --server="$KUBEAPI_URL" \
      --embed-certs \
      --certificate-authority="$kubeapi_server_ca_crt"
    kubectl config --kubeconfig "$KUBECONFIG" set-credentials "$__username@$__cluster" \
      --exec-api-version="client.authentication.k8s.io/v1beta1" \
      --exec-command="$(realpath "${BASH_SOURCE[0]}")" \
      --exec-arg="cert" \
      --exec-arg="-k$__keyuri" \
      --exec-arg="-u$__username" \
      --exec-arg="-c$__ca_url" \
      --exec-arg="$KUBEAPI_HOSTNAME"
    kubectl config --kubeconfig "$HOME/.kube/config.yaml" set-context "$__context" \
      --cluster "$__cluster" --user "$__username@$__cluster"
    rm -f "$user_crt" "$user_key"
  elif $get_kube_cert; then
    trap 'error "Failed to get certificate, run with LOGLEVEL=verbose to see more detailed errors"' ERR
    if [[ ! -e $user_crt ]] || \
        step certificate needs-renewal --expires-in 50% "$user_crt" 2>&1 | LOGPROGRAM=step pipe_verbose; then
      debug "Renewing client certificate"
      local pubkey_pem admin_jwk kid alg header_json header payload_json signature step_logs
      pubkey_pem=$(step kms key "$__keyuri" 2> >(LOGPROGRAM=step pipe_verbose))
      admin_jwk=$(step crypto jwk create --force --use sig --from-pem=<(printf "%s\n" "$pubkey_pem") \
        /dev/stdout /dev/null 2> >(LOGPROGRAM=step pipe_verbose))
      debug "JWK:\n%s" "$admin_jwk"
      kid=$(jq -r .kid <<<"$admin_jwk")
      alg=$(jq -r .alg <<<"$admin_jwk")
      header_json=$(jq '{
        "alg": .alg,
        "kid": .kid,
        "typ": "JWT"
      }' <<<"$admin_jwk")
      debug "JWT Header:\n%s" "$header_json"
      header=$(jq -cS . <<<"$header_json" | base64 -w0 | tr -d '=' | tr '/+' '_-')
      local tries_remaining jwt
      for tries_remaining in {2..0}; do
        payload_json=$(jq -n \
          --arg ca_url "$__ca_url" --argjson now "$(date +%s)" --arg kid "$kid" \
          --arg jti "$(step crypto rand --format hex 64)" --arg sub "$__username" '{
          "aud": ($ca_url + "/1.0/sign"),
          "exp": ($now + 1000),
          "iat": $now,
          "iss": $kid,
          "jti": $jti,
          "nbf": ($now - 1000),
          "sans": [$sub],
          "sub": $sub
        }')
        debug "JWT Payload:\n%s" "$payload_json"
        payload=$(jq -cS . <<<"$payload_json" | base64 -w0 | tr -d '=' | tr '/+' '_-')
        signature=$(step kms sign --format jws --in <(printf "%s.%s" "$header" "$payload") \
          --kms "${__keyuri%%:*}" "$__keyuri" | fixup_ecdsa_jws "$alg")
        jwt=$header.$payload.$signature
        debug "JWT: %s" "$jwt"
        if step_logs=$(step ca certificate --ca-url="$__ca_url" --root="$kubeapi_client_ca_crt" \
          --token="$jwt" --force \
          "$__username" "$user_crt" "$user_key" 2>&1); then
          break
        elif (( tries_remaining > 0 )); then
          error "Failed to issue kube-api certificate (%d tries remaining):\n%s" "$tries_remaining" "$step_logs"
          sleep 5
        else
          fatal "Failed to issue kube-api certificate (aborting):\n%s" "$step_logs"
        fi
      done
    fi
    local cert key
    cert=$(cat "$user_crt")
    key=$(cat "$user_key")
    printf '{
  "apiVersion": "client.authentication.k8s.io/v1beta1",
  "kind": "ExecCredential",
  "status": {
    "clientCertificateData": "%s",
    "clientKeyData": "%s"
  }
}
' "${cert//$'\n'/'\n'}" "${key//$'\n'/'\n'}"
  fi
}

# step kms sign --format jws should output a JWS-ready signature, but for ECDSA
# keys it outputs the raw signature bytes in whatever format the underlying KMS
# plugin uses. The SSH agent plugin (sshagentkms) uses SSH wire format; other
# plugins may use DER. Neither is what JWS requires.
#
# JWT/JWS (RFC 7518 §3.4) requires ECDSA signatures as raw r||s concatenation:
# two fixed-width big-endian integers, each exactly coord_len bytes, zero-padded.
# Both DER and SSH wire format add length metadata and may add a leading 0x00
# byte to r or s when their high bit is set (to keep them positive integers).
# This function detects the format and normalises to raw r||s.
#
# Format detection by size (real-world ECDSA r and s are always close to
# coord_len bytes, so total encoded size reliably distinguishes the formats):
#   raw r||s:       exactly coord_len * 2 bytes  →  pass through unchanged
#   DER SEQUENCE:   > coord_len * 2 bytes, first byte 0x30
#   SSH wire:       > coord_len * 2 bytes, first byte 0x00 (big-endian length)
fixup_ecdsa_jws() {
  local alg=$1 b64 coord_len hex sig_len
  local i=0 len val_hex raw_hex="" _part seq_len_byte
  b64=$(cat)
  # coord_len is the byte width of each of r and s for this curve
  case $alg in
    ES256) coord_len=32 ;;  # P-256
    ES384) coord_len=48 ;;  # P-384
    ES512) coord_len=66 ;;  # P-521 (521 bits rounds up to 66 bytes)
    # Non-ECDSA algorithms (e.g. EdDSA) need no conversion
    *) printf "%s\n" "$b64"; return 0 ;;
  esac
  # Decode to hex. od -An -tx1 -v: no address column, single bytes, no
  # repeated-line abbreviation (*) — the -v is critical since repeated byte
  # values (e.g. all 0xff) would otherwise be silently collapsed to a single *
  hex=$(step base64 -d <<<"$b64" | od -An -tx1 -v | tr -d ' \n')
  sig_len=$(( ${#hex} / 2 ))
  if (( sig_len == coord_len * 2 )); then
    # Already raw r||s — nothing to do
    printf "%s\n" "$b64"
    return 0
  elif (( sig_len > coord_len * 2 && 16#${hex:0:2} == 0x30 )); then
    # DER SEQUENCE { INTEGER r, INTEGER s }
    # Skip the SEQUENCE tag (0x30) and its length field. The length is normally
    # one byte, but handle long-form (0x80 | n_bytes) just in case.
    i=2
    seq_len_byte=$(( 16#${hex:2:2} ))
    if (( seq_len_byte & 0x80 )); then
      i=$(( i + 2 + (seq_len_byte & 0x7f) * 2 ))
    else
      i=$(( i + 2 ))
    fi
    for _part in r s; do
      # Each INTEGER: tag 0x02, one-byte length, value
      (( 16#${hex:$i:2} == 0x02 )) || fatal 'fixup_ecdsa_jws: expected INTEGER tag'
      i=$(( i + 2 ))
      len=$(( 16#${hex:$i:2} ))
      i=$(( i + 2 ))
      val_hex=${hex:$i:$(( len * 2 ))}
      i=$(( i + len * 2 ))
      # DER prepends 0x00 when the high bit is set to keep the integer positive.
      # Strip it — JWS uses fixed-width unsigned encoding.
      if (( len > coord_len && 16#${val_hex:0:2} == 0 )); then
        val_hex=${val_hex:2}
      fi
      # Left-pad to exactly coord_len bytes (handles unusually small values)
      while (( ${#val_hex} < coord_len * 2 )); do val_hex="00${val_hex}"; done
      raw_hex+=$val_hex
    done
  else
    # SSH wire format: each integer is a big-endian uint32 length followed by
    # the value, with the same 0x00 high-bit padding convention as DER
    for _part in r s; do
      len=$(( 16#${hex:$i:8} ))  # 4-byte / 8 hex-char big-endian length
      i=$(( i + 8 ))
      val_hex=${hex:$i:$(( len * 2 ))}
      i=$(( i + len * 2 ))
      # Strip leading 0x00 pad byte if present
      if (( len > coord_len && 16#${val_hex:0:2} == 0 )); then
        val_hex=${val_hex:2}
      fi
      # Left-pad to exactly coord_len bytes
      while (( ${#val_hex} < coord_len * 2 )); do val_hex="00${val_hex}"; done
      raw_hex+=$val_hex
    done
  fi
  # Convert hex string to binary and base64url-encode. Binary must flow through
  # a pipe — capturing it via $() would silently drop null bytes (0x00).
  local bin_hex=''
  for (( i=0; i<${#raw_hex}; i+=2 )); do
    bin_hex+="\\x${raw_hex:$i:2}"
  done
  printf '%b' "$bin_hex" | step base64 -u
}

main "$@"
